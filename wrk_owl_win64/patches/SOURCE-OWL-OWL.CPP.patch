-  char     Code[6];
-};
-
-static const int  CODEDISP = offsetof(TInstanceThunk, Code) -
-                             offsetof(TInstanceThunk, WndProcPtr);
-
+// Win64 (MDBCC-01): no per-window executable x86 thunk. CreateInstanceThunk returns
+// the single static dispatcher StdWndProc; `this` is bound to the HWND via GWLP_USERDATA
+// (InitWndProc / TWindow::SubclassWindowFunction), and StdWndProc recovers it from there.
+// The old TInstanceThunk struct + CODEDISP + the emitted x86 trampoline are deleted:
+// a heap RWX code blob with 32-bit pointer fields cannot run as native x64 code.
 WNDPROC
 CreateInstanceThunk(TWindow* w)
 {
-  TInstanceThunk*  thunk = new TInstanceThunk;
-
-  thunk->Call = 0xE8;         // CALL rel32
-  thunk->Offset = CODEDISP;   // relative displacement to Code[5]
-  thunk->WndProcPtr = StdWndProcInstance;
-  thunk->Window = w;
-
-  //
-  // POP ECX
-  //
-  // pop return address of call into ecx (address of member "WndProcPtr")
-  //
-  thunk->Code[0] = 0x59;
-
-  //
-  // MOV EAX,[ECX+4]
-  //
-  // load "Window" into ebx
-  //
-  thunk->Code[1] = 0x8B;     // MOV r32,r/m32
-  thunk->Code[2] = 0x41;     // eax,disp8[ECX]
-  thunk->Code[3] = 0x04;     // +4
-
-  //
-  // JMP [ECX]
-  //
-  // jump to window function StdWndProc
-  //
-  thunk->Code[4] = 0xFF;     // JMP r/m32
-  thunk->Code[5] = 0x21;     // [ECX]
-
-  return (WNDPROC)thunk;
+  (void)w;
+  return (WNDPROC)StdWndProc;
 }
 
